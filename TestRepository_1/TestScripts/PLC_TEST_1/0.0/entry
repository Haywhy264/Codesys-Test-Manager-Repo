            print("Error executing '" + flag_name + "': " + str(e))
            continue

        end_time = datetime.now()
        duration = exec_end - exec_start

        print("Finished '{}' at {}".format(flag_name, end_time.strftime('%Y-%m-%d %H:%M:%S')))<![CDATA[
