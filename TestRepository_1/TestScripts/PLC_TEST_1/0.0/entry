import time
from datetime import datetime

# Locate the 'System_Events' program instance
system_events_prg = projects.primary.find('System_Events', recursive=True)

# Define system control functions
def reboot():
    system.reboot()

def reset_plc(mode):
    system.reset(mode=mode)

def get_plc_info():
    system.get_info()

def save_project():
    system.save_project()

# Map flags to corresponding actions
system_actions = {
    'xRebootSystem': reboot,
    'xResetPLCCold': lambda: reset_plc('cold'),
    'xResetPLCWarm': lambda: reset_plc('warm'),
    'xResetPLCOrigin': lambda: reset_plc('origin'),
    'xGetPLCInfo': get_plc_info,
    'xSaveSystem': save_project
}

# Monitor and execute flagged actions
for flag_name, action in system_actions.items():
    # Search for the flag variable manually in system_events_prg
    flag = None
    if hasattr(system_events_prg, 'children'):
        for child in system_events_prg.children:
            if child.name == flag_name:
                flag = child
                break

    if flag and flag.value:
        start_time = datetime.now()
        print("Started '{}' at {}".format(flag_name, start_time.strftime('%Y-%m-%d %H:%M:%S')))

