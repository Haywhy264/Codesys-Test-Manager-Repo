            <Entry Name="Command">from scriptengine import *
import time
from datetime import datetime

# Locate the 'System(PRG)' program instance
program_instance = projects.primary.find('System(PRG)', recursive=True)

# Simulated GVL system structure
GVL_SYSTEM = {
    'sINIFolder': '',
    'sINIFolderDflt': 'default_folder',
    'sRoot': '/root/',
    'xFileInitReady': True,
    'xPlantReady': True,
    'xSensorReady': True,
    'xControlReady': True,
    'xServerReady': True,
    'xLoggingReady': True
}

# Simulated method handlers
def Sensor_Load_Handler():
    time.sleep(0.1)

def Control_Load_Handler():
    time.sleep(0.2)

def Server_Load_Handler():
    time.sleep(0.15)

def Logging_Load_Handler():
    time.sleep(0.25)

# Sequence steps and their corresponding actions
sequence_steps = [
    'SYS_INIT',
    'FILE_INIT',
    'PLANT_INIT',
    'SENSOR_INIT',
    'CONTROL_INIT',
    'SERVER_INIT',
    'LOGGING_INIT',
    'RUN'
]

# Execution log
execution_log = []

# Simulate sequence execution
for step in sequence_steps:
    start_time = datetime.now()
    start_ts = time.time()

    # Simulate each step's logic
    if step == 'SYS_INIT':
        if GVL_SYSTEM['sINIFolder'] == '':
            GVL_SYSTEM['sINIFolder'] = GVL_SYSTEM['sINIFolderDflt']
        time.sleep(0.05)

    elif step == 'FILE_INIT':
        time.sleep(0.05)
        GVL_SYSTEM['xFileInitReady'] = True

    elif step == 'PLANT_INIT':
        time.sleep(0.05)

    elif step == 'SENSOR_INIT':
        Sensor_Load_Handler()

    elif step == 'CONTROL_INIT':
        Control_Load_Handler()

    elif step == 'SERVER_INIT':
        Server_Load_Handler()

    elif step == 'LOGGING_INIT':
        Logging_Load_Handler()

    elif step == 'RUN':
        time.sleep(0.05)

    end_ts = time.time()
    end_time = datetime.now()
    duration = end_ts - start_ts

    # Log the result
    execution_log.append({
        'Step': step,
        'Start Time': start_time.strftime('%Y-%m-%d %H:%M:%S.%f'),
        'End Time': end_time.strftime('%Y-%m-%d %H:%M:%S.%f'),
        'Duration (s)': round(duration, 3)
    })

# Print execution results
for entry in execution_log:
    print(f"Step: {entry['Step']}")
    print(f"  Start Time: {entry['Start Time']}")
    print(f"  End Time:   {entry['End Time']}")
    print(f"  Duration:   {entry['Duration (s)']} seconds\n")</Entry>
